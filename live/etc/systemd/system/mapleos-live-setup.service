[Unit]
Description=Initialize the disposable MapleOS live account
After=systemd-sysusers.service systemd-tmpfiles-setup.service
Before=display-manager.service
ConditionPathExists=/etc/mapleos-live

[Service]
Type=oneshot
ExecStart=/usr/local/lib/mapleos-live-setup
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
